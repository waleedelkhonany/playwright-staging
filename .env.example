# =============================================================================
# CareConnect KSA - E2E Test Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NOTE: These values override config.json when both exist.
# =============================================================================

# --- Target Application ---
BASE_URL=https://your-staging-instance.com

# --- Authentication ---
APP_USERNAME=your-username
APP_PASSWORD=your-password

# --- Timeouts (milliseconds) ---
NAVIGATION_TIMEOUT=30000
ELEMENT_TIMEOUT=10000

# --- Browser Settings ---
HEADLESS=false

# --- Reporting ---
SCREENSHOT_MODE=only-on-failure

# --- Trace Recording ---
# When to collect/keep traces (viewable with: npx playwright show-trace):
#   on-first-retry      -> collect a trace when retrying a failed test
#   on                 -> collect a trace for EVERY test
#   off                -> do not collect traces
#   retain-on-failure  -> collect for every run, keep only failures
TRACE_MODE=on-first-retry

# --- Video Recording ---
# When to record/keep videos:
#   on                  -> record and keep a video for EVERY test
#   off                 -> do not record video
#   retain-on-failure   -> record for every run, keep only failures
#   on-first-retry      -> record only on the first retry of a test
VIDEO_MODE=on
# Video resolution/quality preset (higher = better quality):
#   low (800x450) | medium (1280x720) | high (1366x768, matches the viewport)
VIDEO_QUALITY=high
