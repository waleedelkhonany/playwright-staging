# =============================================================================
# CareConnect KSA - E2E Test Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NOTE: If both .env and config.json exist, .env values override config.json.
# =============================================================================

# --- Target Application ---
BASE_URL=https://staging.careconnectksa.com

# --- Authentication ---
TEST_USERNAME=Waleed
TEST_PASSWORD=admin@1234

# --- Timeouts (milliseconds) ---
NAVIGATION_TIMEOUT=30000
ELEMENT_TIMEOUT=10000

# --- Browser Settings ---
HEADLESS=true
VIEWPORT_WIDTH=1366
VIEWPORT_HEIGHT=768

# --- Reporting ---
SCREENSHOT_MODE=only-on-failure
VIDEO_MODE=retain-on-failure
TRACE_MODE=on-first-retry
